<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.springgraph.examples</groupId>
  <artifactId>maven-lombok</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <lombok.version>1.18.48</lombok.version>
    <springgraph.version>0.1.0-rc.1</springgraph.version>
    <!-- override on the command line to try modes/boundaries: -Dsg.mode=advisory -->
    <sg.mode>strict</sg.mode>
    <sg.boundaries></sg.boundaries>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <version>7.0.10</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <annotationProcessorPaths>
            <!-- Order matters; see docs/evaluation/maven-lombok.md -->
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <path>
              <groupId>io.springgraph</groupId>
              <artifactId>springgraph-processor</artifactId>
              <version>${springgraph.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Aspringgraph.mode=${sg.mode}</arg>
            <arg>-Aspringgraph.runtimeBoundaries=${sg.boundaries}</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
